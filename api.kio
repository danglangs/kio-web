// JSON API helpers over web.kio and json.kio. The app declares `mod web; mod json; mod api;`.

// Respond with `j` encoded as application/json.
pub fn json(status: Int, j: json::Json) -> web::Response {
    web::json(status, json::encode(j))
}

// Respond with `{"error": msg}`.
pub fn error(status: Int, msg: Str) -> web::Response {
    let mut o: Map<Str, json::Json> = Map::new();
    o.insert("error", json::Json::Str(msg));
    json(status, json::Json::Obj(o))
}

// The request body as JSON, or a 400 response carrying the parse message.
pub fn body(r: web::Request) -> Result<json::Json, web::Response> {
    match json::parse(r.body.to_str()) {
        Ok(j) => Ok(j),
        Err(e) => Err(error(400, e)),
    }
}

pub fn str_field(j: json::Json, key: Str) -> Option<Str> {
    json::as_str(json::get(j, key)?)
}

pub fn int_field(j: json::Json, key: Str) -> Option<Int> {
    json::as_int(json::get(j, key)?)
}

// The string fields `keys` of the request body, in that order, or a 400 response naming the
// first problem: bad JSON, or a field that is missing or not a string.
pub fn str_fields(r: web::Request, keys: List<Str>) -> Result<List<Str>, web::Response> {
    let j = body(r)?;
    let mut out: List<Str> = [];
    for k in keys {
        match str_field(j, k) {
            Some(s) => out.push(s),
            None => return Err(error(400, "missing string field \"" + k + "\"")),
        }
    }
    Ok(out)
}
