// JSON API helpers over web.kio. The app declares `mod web; mod api;`.

// Respond with `j` encoded as application/json.
pub fn json(status: Int, j: Json) -> web::Response {
    web::json(status, j.to_json())
}

// Respond with `{"error": msg}`.
pub fn error(status: Int, msg: Str) -> web::Response {
    let mut o: Map<Str, Json> = Map::new();
    o.insert("error", Json::Str(msg));
    json(status, Json::Obj(o))
}

// The request body as JSON, or a 400 response carrying the parse message.
pub fn body(r: web::Request) -> Result<Json, web::Response> {
    match r.body.to_str().parse_json() {
        Ok(j) => Ok(j),
        Err(e) => Err(error(400, e)),
    }
}

pub fn str_field(j: Json, key: Str) -> Option<Str> {
    j.get(key)?.as_str()
}

pub fn int_field(j: Json, key: Str) -> Option<Int> {
    j.get(key)?.as_int()
}

// The string fields `keys` of the request body, in that order, or a 400 response naming the
// first problem: bad JSON, or a field that is missing or not a string.
pub fn str_fields(r: web::Request, keys: List<Str>) -> Result<List<Str>, web::Response> {
    let j = body(r)?;
    let mut out: List<Str> = [];
    for k in keys {
        match str_field(j, k) {
            Some(s) => out.push(s),
            None => return Err(error(400, "missing string field \"" + k + "\"")),
        }
    }
    Ok(out)
}

// A path parameter as an integer, or a 400 saying `what` must be one.
pub fn int_param(s: Str, what: Str) -> Result<Int, web::Response> {
    match s.parse_int() {
        Some(n) => Ok(n),
        None => Err(error(400, what + " must be an integer")),
    }
}

// The first element, if any.
pub fn first<T>(xs: List<T>) -> Option<T> {
    if xs.len() == 0 { None } else { Some(xs[0]) }
}

// The values present in `xs`, in order.
pub fn flatten<T>(xs: List<Option<T>>) -> List<T> {
    let mut out: List<T> = [];
    for x in xs {
        if let Some(v) = x { out.push(v); }
    }
    out
}

// One page of a listing: `items` are elements offset.. of `total`.
pub struct Page<T> { items: List<T>, total: Int, offset: Int }

// The page of `xs` that the query parameters `offset` (default 0) and `limit` (default: all) ask for.
pub fn page<T>(xs: List<T>, r: web::Request) -> Page<T> {
    let q = web::query(r);
    let offset = q.get("offset").and_then(|s| s.parse_int()).unwrap_or(0);
    let limit = q.get("limit").and_then(|s| s.parse_int()).unwrap_or(xs.len());
    let mut items: List<T> = [];
    let mut i = if offset < 0 { 0 } else { offset };
    while i < xs.len() && items.len() < limit {
        items.push(xs[i]);
        i += 1;
    }
    Page { items: items, total: xs.len(), offset: offset }
}
