// Tests for api.kio: `kio run tests/api_test.kio` prints 0 when every check passes,
// or the number of the first failing check.
mod web;
mod api;

fn req(body: Str) -> web::Request {
    let hs: List<web::Header> = [];
    web::Request { method: "POST", path: "/", query: "", headers: hs, body: body.to_bytes() }
}

fn get(query: Str) -> web::Request {
    web::Request { method: "GET", path: "/", query: query, headers: [], body: "".to_bytes() }
}

fn main() -> Int {
    let e = api::error(404, "no \"x\"");
    if e.status != 404 { return 1; }
    if e.body.to_str() != "{\"error\":\"no \\\"x\\\"\"}" { return 2; }
    if e.headers[0].value != "application/json" { return 3; }
    let r = api::json(201, Json::Arr([Json::Num(1), Json::Null]));
    if r.status != 201 { return 4; }
    if r.body.to_str() != "[1,null]" { return 5; }
    match api::body(req("{\"a\":\"x\",\"n\":7}")) {
        Ok(j) => {
            if api::str_field(j, "a").unwrap_or("") != "x" { return 6; }
            if api::int_field(j, "n").unwrap_or(0) != 7 { return 7; }
            match api::str_field(j, "n") { Some(_) => { return 8; } None => {} }
            match api::int_field(j, "a") { Some(_) => { return 9; } None => {} }
            match api::str_field(j, "zz") { Some(_) => { return 10; } None => {} }
        }
        Err(_) => { return 11; }
    }
    match api::body(req("{\"a\":")) {
        Ok(_) => { return 12; }
        Err(x) => {
            if x.status != 400 { return 13; }
            if !x.body.to_str().contains("at byte") { return 14; }
        }
    }
    match api::str_fields(req("{\"a\":\"x\",\"b\":\"y\"}"), ["b", "a"]) {
        Ok(v) => { if v[0] != "y" || v[1] != "x" { return 15; } }
        Err(_) => { return 16; }
    }
    match api::str_fields(req("{\"a\":\"x\"}"), ["a", "b"]) {
        Ok(_) => { return 17; }
        Err(x) => {
            if x.status != 400 { return 18; }
            if !x.body.to_str().contains("field \\\"b") { return 19; }
        }
    }
    match api::str_fields(req("{\"a\":1}"), ["a"]) {
        Ok(_) => { return 20; }
        Err(x) => { if x.status != 400 { return 21; } }
    }
    match api::str_fields(req("{"), ["a"]) {
        Ok(_) => { return 22; }
        Err(x) => { if !x.body.to_str().contains("at byte") { return 23; } }
    }
    // int_param, first, flatten, page.
    match api::int_param("12", "id") { Ok(n) => { if n != 12 { return 24; } } Err(_) => { return 25; } }
    match api::int_param("x", "note id") {
        Ok(_) => { return 26; }
        Err(x) => {
            if x.status != 400 { return 27; }
            if !x.body.to_str().contains("note id must be an integer") { return 28; }
        }
    }
    if api::first([7, 8]).unwrap_or(0) != 7 { return 29; }
    let none: List<Str> = [];
    if api::first(none).is_some() { return 30; }
    let opts = [Some(1), None, Some(3)];
    let flat = api::flatten(opts);
    if flat.len() != 2 || flat[1] != 3 { return 31; }
    let xs = [1, 2, 3, 4, 5];
    match api::page(xs, req("")) {
        Ok(all) => { if all.items.len() != 5 || all.total != 5 || all.limit != 50 { return 32; } }
        Err(_) => { return 33; }
    }
    match api::page(xs, get("offset=1&limit=2")) {
        Ok(p) => { if p.items.len() != 2 || p.items[0] != 2 || p.total != 5 || p.offset != 1 || p.limit != 2 { return 34; } }
        Err(_) => { return 35; }
    }
    match api::page(xs, get("offset=9&limit=2")) {
        Ok(p) => { if p.items.len() != 0 { return 36; } }
        Err(_) => { return 37; }
    }
    match api::page(xs, get("offset=-3")) {
        Ok(_) => { return 38; }
        Err(x) => { if x.status != 400 || !x.body.to_str().contains("offset must be 0 to") { return 39; } }
    }
    match api::page(xs, get("limit=x")) {
        Ok(_) => { return 40; }
        Err(x) => { if x.status != 400 || !x.body.to_str().contains("limit must be an integer") { return 41; } }
    }
    match api::page(xs, get("limit=501")) {
        Ok(_) => { return 42; }
        Err(x) => { if !x.body.to_str().contains("limit must be 0 to 500") { return 43; } }
    }
    match api::page(xs, get("limit=500")) {
        Ok(p) => { if p.items.len() != 5 || p.limit != 500 { return 44; } }
        Err(_) => { return 45; }
    }
    let mut big: List<Int> = [];
    for i in 0..120 { big.push(i); }
    match api::page(big, req("")) {
        Ok(p) => { if p.items.len() != 50 || p.total != 120 { return 46; } }
        Err(_) => { return 47; }
    }
    0
}
