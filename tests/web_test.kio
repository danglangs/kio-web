// Tests for web.kio: `kio run tests/web_test.kio` prints 0 when every check passes,
// or the number of the first failing check.
mod web;

fn req(method: Str, path: Str, query: Str) -> web::Request {
    let hs: List<web::Header> = [];
    web::Request { method: method, path: path, query: query, headers: hs, body: "".to_bytes() }
}

enum Act { Home, List, Show, Make }

fn table() -> List<web::Route<Act>> {
    [web::get("/", Act::Home), web::get("/notes", Act::List), web::get("/notes/:id", Act::Show),
     web::post("/notes", Act::Make)]
}

fn main() -> Int {
    // route: a path parameter and a mismatch.
    match web::route(req("GET", "/hello/kio", ""), "GET", "/hello/:name") {
        Some(p) => if p.get(":name").unwrap_or("") != "kio" { return 1; },
        None => { return 2; }
    }
    match web::route(req("POST", "/hello/kio", ""), "GET", "/hello/:name") {
        Some(_) => { return 3; }
        None => {}
    }
    match web::route(req("GET", "/a/b", ""), "GET", "/a") {
        Some(_) => { return 4; }
        None => {}
    }
    // query and percent-decoding.
    let q = web::query(req("GET", "/", "name=a%20b&x=1+2"));
    if q.get("name").unwrap_or("") != "a b" { return 5; }
    if q.get("x").unwrap_or("") != "1 2" { return 6; }
    if web::decode("%41%zz%4") != "A%zz%4" { return 7; }
    // JSON escaping.
    if web::json_str("a\"b\\c") != "\"a\\\"b\\\\c\"" { return 8; }
    // responses.
    let r = web::text(201, "hi");
    if r.status != 201 { return 9; }
    if r.body.to_str() != "hi" { return 10; }
    if web::not_found().status != 404 { return 11; }
    if web::strip_slash("/index.html") != "index.html" { return 12; }
    if web::strip_slash("a/b") != "a/b" { return 13; }
    if web::strip_slash("/") != "" { return 14; }
    // dispatch: method, path, params, order, no match.
    match web::dispatch(table(), req("GET", "/notes/7", "")) {
        Some(m) => {
            if m.action != Act::Show { return 15; }
            if web::param(m, "id") != "7" { return 16; }
        }
        None => { return 17; }
    }
    match web::dispatch(table(), req("POST", "/notes", "")) {
        Some(m) => { if m.action != Act::Make { return 18; } }
        None => { return 19; }
    }
    match web::dispatch(table(), req("GET", "/", "")) {
        Some(m) => { if m.action != Act::Home { return 20; } }
        None => { return 21; }
    }
    match web::dispatch(table(), req("DELETE", "/notes/7", "")) { Some(_) => { return 22; } None => {} }
    match web::dispatch(table(), req("GET", "/nope", "")) { Some(_) => { return 23; } None => {} }
    let first = [web::get("/a/:x", 1), web::get("/a/b", 2)];
    match web::dispatch(first, req("GET", "/a/b", "")) {
        Some(m) => { if m.action != 1 || web::param(m, "x") != "b" { return 24; } }
        None => { return 25; }
    }
    if web::param(web::Matched { action: 0, params: Map::new() }, "id") != "" { return 26; }
    0
}
