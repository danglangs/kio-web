// Tests for web.kio: `kio run tests/web_test.kio` prints 0 when every check passes,
// or the number of the first failing check.
mod web;

fn req(method: Str, path: Str, query: Str) -> web::Request {
    let hs: List<web::Header> = [];
    web::Request { method: method, path: path, query: query, headers: hs, body: "".to_bytes() }
}

enum Act { Home, List, Show, Make }

fn table() -> List<web::Route<Act>> {
    [web::get("/", Act::Home), web::get("/notes", Act::List), web::get("/notes/:id", Act::Show),
     web::post("/notes", Act::Make)]
}

fn main() -> Int {
    // route: a path parameter and a mismatch.
    match web::route(req("GET", "/hello/kio", ""), "GET", "/hello/:name") {
        Some(p) => if p.get(":name").unwrap_or("") != "kio" { return 1; },
        None => { return 2; }
    }
    match web::route(req("POST", "/hello/kio", ""), "GET", "/hello/:name") {
        Some(_) => { return 3; }
        None => {}
    }
    match web::route(req("GET", "/a/b", ""), "GET", "/a") {
        Some(_) => { return 4; }
        None => {}
    }
    // query and percent-decoding.
    let q = web::query(req("GET", "/", "name=a%20b&x=1+2"));
    if q.get("name").unwrap_or("") != "a b" { return 5; }
    if q.get("x").unwrap_or("") != "1 2" { return 6; }
    if web::decode("%41%zz%4") != "A%zz%4" { return 7; }
    // JSON escaping.
    if web::json_str("a\"b\\c") != "\"a\\\"b\\\\c\"" { return 8; }
    // responses.
    let r = web::text(201, "hi");
    if r.status != 201 { return 9; }
    if r.body.to_str() != "hi" { return 10; }
    if web::not_found().status != 404 { return 11; }
    if web::strip_slash("/index.html") != "index.html" { return 12; }
    if web::strip_slash("a/b") != "a/b" { return 13; }
    if web::strip_slash("/") != "" { return 14; }
    // dispatch: method, path, params, order, no match.
    match web::dispatch(table(), req("GET", "/notes/7", "")) {
        Some(m) => {
            if m.action != Act::Show { return 15; }
            if web::param(m, "id") != "7" { return 16; }
        }
        None => { return 17; }
    }
    match web::dispatch(table(), req("POST", "/notes", "")) {
        Some(m) => { if m.action != Act::Make { return 18; } }
        None => { return 19; }
    }
    match web::dispatch(table(), req("GET", "/", "")) {
        Some(m) => { if m.action != Act::Home { return 20; } }
        None => { return 21; }
    }
    match web::dispatch(table(), req("DELETE", "/notes/7", "")) { Some(_) => { return 22; } None => {} }
    match web::dispatch(table(), req("GET", "/nope", "")) { Some(_) => { return 23; } None => {} }
    let first = [web::get("/a/:x", 1), web::get("/a/b", 2)];
    match web::dispatch(first, req("GET", "/a/b", "")) {
        Some(m) => { if m.action != 1 || web::param(m, "x") != "b" { return 24; } }
        None => { return 25; }
    }
    if web::param(web::Matched { action: 0, params: Map::new() }, "id") != "" { return 26; }
    // HTML escaping, html and redirect responses.
    if web::html_escape("<a href=\"x\">Tom & Jerry's</a>") != "&lt;a href=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/a&gt;" { return 27; }
    if web::html_escape("plain é") != "plain é" { return 28; }
    if web::html(200, "<p>").headers[0].value != "text/html; charset=utf-8" { return 29; }
    let rd = web::redirect(302, "https://example.com/");
    if rd.status != 302 { return 30; }
    if rd.headers.len() != 2 || rd.headers[1].name != "location" || rd.headers[1].value != "https://example.com/" { return 31; }
    // bearer, wildcard, HEAD, protected routes.
    let mut authed = req("GET", "/", "");
    authed.headers.push(web::Header { name: "authorization", value: "Bearer s3cret" });
    if web::bearer(authed).unwrap_or("") != "s3cret" { return 32; }
    if web::bearer(req("GET", "/", "")).is_some() { return 33; }
    authed.headers[0].value = "Basic s3cret";
    if web::bearer(authed).is_some() { return 34; }
    match web::route(req("GET", "/static/a/b.css", ""), "GET", "/static/*path") {
        Some(p) => if p.get("*path").unwrap_or("") != "a/b.css" { return 35; },
        None => { return 36; }
    }
    match web::route(req("GET", "/static/x", ""), "GET", "/static/*path") {
        Some(p) => if p.get("*path").unwrap_or("") != "x" { return 37; },
        None => { return 38; }
    }
    match web::route(req("GET", "/other/x", ""), "GET", "/static/*path") { Some(_) => { return 39; } None => {} }
    match web::route(req("GET", "/static", ""), "GET", "/static/*path") { Some(_) => { return 40; } None => {} }
    let wild = [web::get("/static/*path", 1)];
    match web::dispatch(wild, req("GET", "/static/a/../b", "")) {
        Some(m) => { if web::param(m, "path") != "a/../b" { return 41; } }
        None => { return 42; }
    }
    match web::route(req("HEAD", "/notes", ""), "GET", "/notes") { Some(_) => {} None => { return 43; } }
    match web::route(req("HEAD", "/notes", ""), "POST", "/notes") { Some(_) => { return 44; } None => {} }
    match web::dispatch(table(), req("HEAD", "/notes/7", "")) {
        Some(m) => { if m.action != Act::Show { return 45; } }
        None => { return 46; }
    }
    let mixed = [web::get("/", 1), web::protected(web::post("/p", 2)), web::protected(web::get("/q/:id", 3))];
    match web::dispatch_as(mixed, req("POST", "/p", ""), true) {
        Ok(Some(m)) => { if m.action != 2 { return 47; } }
        _ => { return 48; }
    }
    match web::dispatch_as(mixed, req("POST", "/p", ""), false) {
        Err(x) => {
            if x.status != 401 { return 49; }
            if x.headers[1].name != "www-authenticate" { return 50; }
        }
        _ => { return 51; }
    }
    match web::dispatch_as(mixed, req("GET", "/", ""), false) {
        Ok(Some(m)) => { if m.action != 1 { return 52; } }
        _ => { return 53; }
    }
    match web::dispatch_as(mixed, req("GET", "/nope/x", ""), false) { Ok(None) => {} _ => { return 54; } }
    match web::dispatch(mixed, req("POST", "/p", "")) { Some(_) => { return 55; } None => {} }
    0
}
