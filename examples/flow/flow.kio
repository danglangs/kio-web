// The ingest logic: plain values and the capabilities it needs, so tests call it directly.
pub fn ingest(key: Hmac, db: Db, now_ms: Int, sig: Option<Str>, body: Bytes) -> web::Response {
    let Some(hex) = sig else { return api::error(401, "missing X-Signature header"); };
    let Some(mac) = hex.trim().from_hex() else { return api::error(401, "bad signature"); };
    if !key.verify(body, mac) { return api::error(401, "bad signature"); }
    let Some(text) = body.try_to_str() else { return api::error(400, "body is not UTF-8"); };
    let j = match text.parse_json() {
        Ok(j) => j,
        Err(e) => return api::error(400, e),
    };
    let Some(id) = api::str_field(j, "id") else { return api::error(400, "missing string field \"id\""); };
    match store(db, id, text, now_ms) {
        Ok(true) => accepted("accepted"),
        Ok(false) => accepted("duplicate"),
        Err(why) => api::error(500, why),
    }
}

fn accepted(what: Str) -> web::Response {
    let mut o: Map<Str, Json> = Map::new();
    o.insert(what, Json::Bool(true));
    api::json(if what == "accepted" { 202 } else { 200 }, Json::Obj(o))
}

// Create the table if needed and add the job: Ok(true) when new, Ok(false) when the id exists.
// The insert is one autocommitted statement, so it is durable before this returns.
fn store(db: Db, id: Str, body: Str, now_ms: Int) -> Result<Bool, Str> {
    let made = db.exec("CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, body TEXT NOT NULL, state TEXT NOT NULL, attempts INTEGER NOT NULL, received_ms INTEGER NOT NULL)", []);
    if made.is_err() { return Err("database error"); }
    let added = db.exec("INSERT OR IGNORE INTO jobs (id, body, state, attempts, received_ms) VALUES (?, ?, 'pending', 0, ?)",
        [SqlValue::Text(id), SqlValue::Text(body), SqlValue::Int(now_ms)]);
    match added {
        Ok(n) => Ok(n == 1),
        Err(_) => Err("database error"),
    }
}

// The job rows as text lines, in arrival order. Empty before the table exists.
pub fn rows(db: Db) -> List<Str> {
    let found = db.query("SELECT id, body, state, attempts, received_ms FROM jobs ORDER BY rowid", []);
    let Ok(rs) = found else { return []; };
    rs.map(|r| text_of(r[0]) + "|" + text_of(r[1]) + "|" + text_of(r[2]) + "|" + int_of(r[3]).to_str() + "|" + int_of(r[4]).to_str())
}

fn text_of(v: SqlValue) -> Str {
    match v { SqlValue::Text(s) => s, _ => "" }
}

fn int_of(v: SqlValue) -> Int {
    match v { SqlValue::Int(n) => n, _ => 0 }
}
