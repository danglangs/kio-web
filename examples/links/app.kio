// A link shortener for a small team, over a granted Kv.
// `kio run app.kio --kv links=links.kv --kv auth=auth.kv --dir assets=./static --rng links_rng --clock now --log log=links.log --http hook=hooks.example --http-methods hook=POST --listen 127.0.0.1:8080`
//   GET    /                  HTML page: the top 20 links by hits
//   GET    /static/<file>     a file from `assets`
//   GET    /<slug>            302 to the link's URL, counting the hit; 410 once its ttl has passed
//   GET    /api/links         links by hits, most first; ?offset= and ?limit= (default 50, at most 500)
//   POST   /api/links         {"url": .., "slug": optional, "ttl_s": optional} creates a link (bearer token)
//   DELETE /api/links/<slug>  removes a link (bearer token)
// A link is stored under `link/<slug>` as {"url", "created_ms", "ttl_s"?} and its hit count under
// `hits/<slug>` (decimal text, counted with `add`). A link created without a slug gets 7 random
// base62 characters from `links_rng`; `created_ms` comes from `now`; creates and deletes are
// written to `log`. The key `token` in `auth` is the SHA-256 hex of the API token (set_token.kio
// stores it). After answering a create, the app POSTs {"event":"created","slug","url"} to `/` on
// `hook`.
mod web;
mod api;
mod http;

fn main(req: Incoming, res: Outgoing, links: Kv, auth: Kv, assets: Dir, links_rng: Rng, now: Clock, log: Log, hook: Http) -> Result<(), WebErr> {
    let a = handle(web::request(req), links, auth, assets, links_rng, now, log);
    web::send(res, a.res)?;
    // The client has its answer once `send` returns, so it waits for neither the count nor the
    // webhook. A count the store refuses is lost: the redirect already went out.
    if let Some(slug) = a.hit { let _n = links.add(hits_key(slug), 1); }
    if let Some(l) = a.made { notify(hook, log, l); }
    Ok(())
}

// The response, the link whose hit `main` counts after sending it, and the link it announces.
struct Answer { res: web::Response, hit: Option<Str>, made: Option<Link> }

fn answer(res: web::Response) -> Answer { Answer { res: res, hit: None, made: None } }

// POST {"event":"created","slug":..,"url":..} to `hook`. A failed post is logged and not retried:
// the link exists either way.
fn notify(hook: Http, log: Log, l: Link) {
    let mut o: Map<Str, Json> = Map::new();
    o.insert("event", Json::Str("created"));
    o.insert("slug", Json::Str(l.slug));
    o.insert("url", Json::Str(l.url));
    if let Err(e) = http::json_request(hook, "POST", "/", Json::Obj(o)) {
        let _written = log.write("hook failed for " + l.slug + ": " + e);
    }
}

enum Act { Home, Follow, List, Create, Delete, Static }

fn routes() -> List<web::Route<Act>> {
    [web::get("/", Act::Home), web::get("/static/*path", Act::Static), web::get("/api/links", Act::List),
     web::protected(web::post("/api/links", Act::Create)),
     web::protected(web::delete("/api/links/:slug", Act::Delete)), web::get("/:slug", Act::Follow)]
}

fn handle(r: web::Request, links: Kv, auth: Kv, assets: Dir, rng: Rng, clock: Clock, log: Log) -> Answer {
    let m = match web::dispatch_as(routes(), r, authorized(r, auth)) {
        Ok(Some(m)) => m,
        Ok(None) => return answer(web::not_found()),
        Err(res) => return answer(res),
    };
    let slug = web::param(m, "slug");
    // A GET that redirects counts a hit; HEAD (link previews, crawlers) does not.
    let mut counts = false;
    let mut made: Option<Link> = None;
    let out: Result<web::Response, web::Response> = match m.action {
        Act::Home => home(links),
        Act::Static => return answer(web::file(assets, web::param(m, "path"))),
        Act::Follow => {
            counts = r.method != "HEAD";
            follow(links, slug, clock)
        }
        Act::List => list(r, links),
        Act::Create => match create(r, links, rng, clock, log) {
            Ok(l) => {
                made = Some(l);
                Ok(api::json(201, view(l)))
            }
            Err(res) => Err(res),
        },
        Act::Delete => delete(links, slug, log),
    };
    // Handlers return Err(response) early, through `?`; either way it is the answer.
    let res = match out {
        Ok(res) => res,
        Err(res) => res,
    };
    let hit: Option<Str> = if counts && res.status == 302 { Some(slug) } else { None };
    Answer { res: res, hit: hit, made: made }
}

// ---- auth

// Whether the request carries `authorization: Bearer <token>` whose SHA-256 is the stored hex
// digest (set_token.kio stores it; the token itself is never stored). With none stored, no one
// is let in. `ct_eq` takes the same time wherever the digests differ.
fn authorized(r: web::Request, auth: Kv) -> Bool {
    let want = match auth.get("token") {
        Ok(Some(t)) => t,
        _ => return false,
    };
    match web::bearer(r) {
        Some(got) => want.len() > 0 && got.sha256().to_hex().ct_eq(want.to_str()),
        None => false,
    }
}

// ---- storage

struct Link { slug: Str, url: Str, hits: Int, created_ms: Int, ttl_s: Option<Int> }

// What `link/<slug>` holds.
struct Record { url: Str, created_ms: Int, ttl_s: Option<Int> }

// The longest ttl: ten years, so `created_ms + ttl_s * 1000` never overflows.
const MAX_TTL_S: Int = 315360000;

fn key(slug: Str) -> Str { "link/" + slug }
fn hits_key(slug: Str) -> Str { "hits/" + slug }

fn storage_error(_e: KvErr) -> web::Response { api::error(500, "storage error") }

fn encode(l: Link) -> Bytes {
    let mut o: Map<Str, Json> = Map::new();
    o.insert("url", Json::Str(l.url));
    o.insert("created_ms", Json::Num(l.created_ms));
    if let Some(t) = l.ttl_s { o.insert("ttl_s", Json::Num(t)); }
    Json::Obj(o).to_json().to_bytes()
}

fn decode(b: Bytes) -> Option<Record> {
    let j = b.to_str().parse_json().ok()?;
    let url = api::str_field(j, "url")?;
    let created = match j.get("created_ms") { Some(Json::Num(n)) => n, _ => 0 };
    let ttl: Option<Int> = match j.get("ttl_s") { Some(Json::Num(n)) => Some(n), _ => None };
    Some(Record { url: url, created_ms: created, ttl_s: ttl })
}

// The record stored under `slug`, if there is one.
fn record_of(links: Kv, slug: Str) -> Result<Option<Record>, web::Response> {
    let raw = match links.get(key(slug)).map_err(storage_error)? {
        Some(b) => b,
        None => return Ok(None),
    };
    match decode(raw) {
        Some(rec) => Ok(Some(rec)),
        None => Err(api::error(500, "corrupt record for " + slug)),
    }
}

// Whether a link with a ttl is past it at `now_ms`.
fn expired(rec: Record, now_ms: Int) -> Bool {
    match rec.ttl_s {
        Some(t) => now_ms >= rec.created_ms + t * 1000,
        None => false,
    }
}

// Every entry under `prefix`, a page of 1,000 at a time.
fn scan_all(links: Kv, prefix: Str) -> Result<List<KvEntry>, web::Response> {
    let mut out: List<KvEntry> = [];
    let mut after: Option<Str> = None;
    let mut more = true;
    while more {
        let page = links.scan(prefix, after, 1000).map_err(storage_error)?;
        more = page.len() == 1000;
        if more { after = Some(page[page.len() - 1].key); }
        for e in page { out.push(e); }
    }
    Ok(out)
}

// Every link, from two scans: the records under `link/` and the counts under `hits/`.
fn all_links(links: Kv) -> Result<List<Link>, web::Response> {
    let mut hits: Map<Str, Int> = Map::new();
    for e in scan_all(links, "hits/")? {
        hits.insert(e.key.strip_prefix("hits/").unwrap_or(e.key), e.value.to_str().parse_int().unwrap_or(0));
    }
    let mut out: List<Link> = [];
    for e in scan_all(links, "link/")? {
        let slug = e.key.strip_prefix("link/").unwrap_or(e.key);
        let rec = match decode(e.value) {
            Some(r) => r,
            None => return Err(api::error(500, "corrupt record for " + slug)),
        };
        out.push(Link { slug: slug, url: rec.url, hits: hits.get(slug).unwrap_or(0), created_ms: rec.created_ms, ttl_s: rec.ttl_s });
    }
    Ok(out)
}

// ---- handlers

// GET /<slug>: one `get` for the record, then the redirect; `main` counts the hit after sending it,
// with one `add`, which the store counts atomically, so concurrent hits are all counted. A link
// with a ttl asks the clock, and answers 410 once it has passed.
fn follow(links: Kv, slug: Str, clock: Clock) -> Result<web::Response, web::Response> {
    if !valid_slug(slug) { return Ok(web::not_found()); }
    let rec = match record_of(links, slug)? {
        Some(r) => r,
        None => return Ok(web::not_found()),
    };
    if rec.ttl_s.is_some() && expired(rec, clock.now_ms()) { return Ok(api::error(410, "link " + slug + " has expired")); }
    Ok(web::redirect(302, rec.url))
}

// POST /api/links
fn create(r: web::Request, links: Kv, rng: Rng, clock: Clock, log: Log) -> Result<Link, web::Response> {
    let j = api::body(r)?;
    let url = match api::str_field(j, "url") {
        Some(u) => u,
        None => return Err(api::error(400, "missing string field \"url\"")),
    };
    if let Some(why) = url_problem(url) { return Err(api::error(400, why)); }
    let ttl: Option<Int> = match j.get("ttl_s") {
        None => None,
        Some(Json::Null) => None,
        Some(Json::Num(n)) => {
            if n < 1 || n > MAX_TTL_S { return Err(api::error(400, "ttl_s must be 1 to " + MAX_TTL_S.to_str() + " seconds")); }
            Some(n)
        }
        Some(_) => return Err(api::error(400, "field \"ttl_s\" must be an integer")),
    };
    let created = clock.now_ms();
    match j.get("slug") {
        Some(Json::Str(slug)) => {
            if let Some(why) = slug_problem(slug) { return Err(api::error(400, why)); }
            let l = Link { slug: slug, url: url, hits: 0, created_ms: created, ttl_s: ttl };
            if !claim(links, l)? { return Err(api::error(409, "slug \"" + slug + "\" is taken")); }
            note(log, "create", l.slug, l.url);
            Ok(l)
        }
        Some(Json::Null) => generated(links, rng, log, url, created, ttl),
        None => generated(links, rng, log, url, created, ttl),
        Some(_) => Err(api::error(400, "field \"slug\" must be a string")),
    }
}

// A link named by 7 random base62 characters (62^7, about 3.5 trillion names); a taken name is
// drawn again, up to 5 times.
fn generated(links: Kv, rng: Rng, log: Log, url: Str, created: Int, ttl: Option<Int>) -> Result<Link, web::Response> {
    for _try in 0..5 {
        let l = Link { slug: slug7(rng), url: url, hits: 0, created_ms: created, ttl_s: ttl };
        if claim(links, l)? {
            note(log, "create", l.slug, l.url);
            return Ok(l);
        }
    }
    Err(api::error(503, "no free slug found, try again"))
}

// One draw in 0..62^7, written in base62 and padded to 7 characters.
fn slug7(rng: Rng) -> Str {
    let mut s = base62(rng.int(0, 3521614606208));
    while s.len() < 7 { s = "0" + s; }
    s
}

// Store `l` if its slug is free; false if it is taken. A `follow` racing an earlier `delete` can
// leave a count under `hits/<slug>`, so a claimed slug's count is reset: it starts at 0.
fn claim(links: Kv, l: Link) -> Result<Bool, web::Response> {
    if !links.swap(key(l.slug), None, Some(encode(l))).map_err(storage_error)? { return Ok(false); }
    links.delete(hits_key(l.slug)).map_err(storage_error)?;
    Ok(true)
}

// One line in the program's log: `create <slug> <url>` or `delete <slug> <url>`. A line the log
// refuses (over its budget) is not an error for the request.
fn note(log: Log, what: Str, slug: Str, url: Str) {
    let _written = log.write(what + " " + slug + " " + url);
}

// GET /api/links
fn list(r: web::Request, links: Kv) -> Result<web::Response, web::Response> {
    let p = api::page(by_hits(all_links(links)?), r)?;
    let mut items: List<Json> = [];
    for l in p.items { items.push(view(l)); }
    let mut o: Map<Str, Json> = Map::new();
    o.insert("items", Json::Arr(items));
    o.insert("total", Json::Num(p.total));
    o.insert("offset", Json::Num(p.offset));
    o.insert("limit", Json::Num(p.limit));
    Ok(api::json(200, Json::Obj(o)))
}

// DELETE /api/links/<slug>: the record and its count.
fn delete(links: Kv, slug: Str, log: Log) -> Result<web::Response, web::Response> {
    if !valid_slug(slug) { return Err(api::error(404, "no link " + slug)); }
    let rec = match record_of(links, slug)? {
        Some(r) => r,
        None => return Err(api::error(404, "no link " + slug)),
    };
    links.delete(key(slug)).map_err(storage_error)?;
    links.delete(hits_key(slug)).map_err(storage_error)?;
    note(log, "delete", slug, rec.url);
    Ok(web::respond(204, "text/plain", "".to_bytes()))
}

// GET /: the top 20 links as an HTML table.
fn home(links: Kv) -> Result<web::Response, web::Response> {
    let top = by_hits(all_links(links)?);
    let mut lines: List<Str> = [];
    for l in top.slice(0, top.len().min(20)) {
        let slug = web::html_escape(l.slug);
        lines.push("<tr><td><a href=\"/" + slug + "\">/" + slug + "</a></td><td>" + web::html_escape(l.url)
            + "</td><td class=\"hits\">" + l.hits.to_str() + "</td></tr>\n");
    }
    let mut rows = lines.join("");
    if rows == "" { rows = "<tr><td colspan=\"3\">No links yet.</td></tr>\n"; }
    Ok(web::html(200, "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Links</title>"
        + "<link rel=\"stylesheet\" href=\"/static/style.css\"></head>\n<body><h1>Top links</h1>\n"
        + "<table><tr><th>Link</th><th>Goes to</th><th>Hits</th></tr>\n" + rows + "</table></body></html>\n"))
}

// The JSON a client sees for a link.
fn view(l: Link) -> Json {
    let mut o: Map<Str, Json> = Map::new();
    o.insert("slug", Json::Str(l.slug));
    o.insert("url", Json::Str(l.url));
    o.insert("hits", Json::Num(l.hits));
    o.insert("short", Json::Str("/" + l.slug));
    o.insert("created_ms", Json::Num(l.created_ms));
    if let Some(t) = l.ttl_s { o.insert("ttl_s", Json::Num(t)); }
    Json::Obj(o)
}

// ---- rules

// Why `url` cannot be a link: an http or https URL with a host, at most 2048 bytes, no spaces or
// control characters (it goes into a `location` header and a log line as is).
fn url_problem(url: Str) -> Option<Str> {
    if url.len() > 2048 { return Some("url is longer than 2048 bytes"); }
    let lower = url.to_lowercase();
    let rest = match lower.strip_prefix("https://") {
        Some(r) => r,
        None => match lower.strip_prefix("http://") {
            Some(r) => r,
            None => return Some("url must start with http:// or https://"),
        },
    };
    let b = url.to_bytes();
    for i in 0..b.len() {
        if b[i] <= 32 || b[i] == 127 { return Some("url has a space or control character"); }
    }
    let host = rest.split("/")[0].split("?")[0].split("#")[0];
    if host == "" { return Some("url has no host"); }
    None
}

// Why `slug` cannot name a link: 1 to 64 of A-Z a-z 0-9 _ -, and not a top-level path the app uses.
fn slug_problem(slug: Str) -> Option<Str> {
    if slug == "" || slug.len() > 64 { return Some("slug must be 1 to 64 characters"); }
    if !valid_slug(slug) { return Some("slug may use only A-Z a-z 0-9 _ -"); }
    if ["api", "static"].contains(slug) { return Some("slug \"" + slug + "\" is reserved"); }
    None
}

fn valid_slug(slug: Str) -> Bool {
    let b = slug.to_bytes();
    if b.len() == 0 || b.len() > 64 { return false; }
    for i in 0..b.len() {
        let c = b[i];
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45;
        if !ok { return false; }
    }
    true
}

fn base62(n: Int) -> Str {
    let digits = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let last = digits.slice(n % 62, n % 62 + 1);
    if n < 62 { last } else { base62(n / 62) + last }
}

// ---- sorting

// Most hits first; equal hits by slug.
fn by_hits(xs: List<Link>) -> List<Link> {
    let mut out = xs;
    out.sort_by(|a, b| a.hits > b.hits || (a.hits == b.hits && a.slug < b.slug));
    out
}
