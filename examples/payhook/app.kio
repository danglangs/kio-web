// payhook step 5: receive webhooks, verify Stripe-Signature, store each event once, tell the chat,
// and retry what the chat refused.
//   POST /stripe  a signed JSON event {"id", "type", ..}: 200 {"received":true}; a replayed id is
//                 200 {"duplicate":true}; 400 for a bad or stale signature (`t=<s>,v1=<hex hmac-sha256
//                 of "<t>.<body>">`, any v1 may match, skew over 300 s either way) or a body that is
//                 not an event; 500 if the database fails (Stripe then retries)
//   GET  /health  200 ok
// Events are rows of `events` in `db` (id is the primary key, so a replay violates it). A
// payment_intent.succeeded or charge.refunded keeps its chat message in `text`, status `pending`,
// until the chat accepts it (2xx: `sent`); any other type is `stored`. The message is POSTed as
// {"text": ..} to /hook on `slack` after the answer to Stripe is sent, so a slow or failing chat
// never costs Stripe a retry; the host adds the chat's Authorization (`--http-header`).
// A failed post (5xx or any non-2xx, a timeout after 2 s, a refused connection) leaves the event
// `pending` with its attempt counted. After answering ANY request (health included), the app retries
// up to 5 pending events, oldest first; the third failed attempt marks an event `failed`, for good.
// An attempt is claimed with a conditional UPDATE of `attempts` before it is made, so concurrent
// requests never send one message twice and never pass 3 attempts, even if a run dies mid-attempt.
// Each accepted event is logged as `<id> <type> <outcome>`: stored, duplicate, notified or pending;
// a retry that succeeds logs `retried`, one that gives up logs `failed`.
// Grants: `--hmac stripe=env:WHSEC:verify --clock now --db db=payhook.db --log log=payhook.log
//   --http slack=https://chat.example --http-methods slack=POST --http-header slack=Authorization:env:CHAT_AUTH`.
mod web;
mod api;

const MAX_ATTEMPTS: Int = 3;
const RETRIES_PER_REQUEST: Int = 5;

fn main(req: Incoming, res: Outgoing, stripe: Hmac, now: Clock, db: Db, log: Log, slack: Http) -> Result<(), WebErr> {
    let a = handle(web::request(req), stripe, now, db);
    web::send(res, a.res)?;
    if let Some(ev) = a.event {
        let mut outcome = a.outcome;
        if outcome == "pending" { outcome = deliver(db, slack, ev.id, ev.text, 0); }
        let _written = log.write(ev.id + " " + ev.kind + " " + outcome);
    }
    let current = match a.event { Some(ev) => ev.id, None => "" };
    retry_pending(db, slack, log, current);
    Ok(())
}

// The response, and the accepted event with its outcome so far (`pending`: still to tell the chat).
struct Answer { res: web::Response, event: Option<Ev>, outcome: Str }

fn answer(res: web::Response) -> Answer { Answer { res: res, event: None, outcome: "" } }

struct Ev { id: Str, kind: Str, text: Str }

enum Act { Health, Stripe }

fn routes() -> List<web::Route<Act>> {
    [web::get("/health", Act::Health), web::post("/stripe", Act::Stripe)]
}

fn handle(r: web::Request, stripe: Hmac, now: Clock, db: Db) -> Answer {
    match web::dispatch(routes(), r) {
        Some(m) => match m.action {
            Act::Health => answer(web::text(200, "ok")),
            Act::Stripe => receive(r, stripe, now, db),
        },
        None => answer(web::not_found()),
    }
}

fn received(key: Str) -> web::Response {
    let mut o: Map<Str, Json> = Map::new();
    o.insert(key, Json::Bool(true));
    api::json(200, Json::Obj(o))
}

fn receive(r: web::Request, stripe: Hmac, now: Clock, db: Db) -> Answer {
    let now_ms = now.now_ms();
    let header = match web::header(r, "stripe-signature") {
        Some(h) => h,
        None => return answer(api::error(400, "missing Stripe-Signature header")),
    };
    if let Err(why) = check_signature(stripe, header, r.body, now_ms / 1000) {
        return answer(api::error(400, why));
    }
    let j = match api::body(r) { Ok(j) => j, Err(e) => return answer(e) };
    let ev = match parse_event(j) { Ok(e) => e, Err(why) => return answer(api::error(400, why)) };
    match store(db, ev, now_ms) {
        Ok(true) => {
            let outcome = if ev.text == "" { "stored" } else { "pending" };
            Answer { res: received("received"), event: Some(ev), outcome: outcome }
        }
        Ok(false) => Answer { res: received("duplicate"), event: Some(ev), outcome: "duplicate" },
        Err(why) => answer(api::error(500, why)),
    }
}

// Tell the chat about event `id`, which has had `attempts` attempts: claim the attempt (a request
// that lost the claim leaves it to the winner), POST the message, record the result. Returns the
// outcome: notified; pending after a failure; failed after the third.
fn deliver(db: Db, slack: Http, id: Str, text: Str, attempts: Int) -> Str {
    let claimed = db.exec("UPDATE events SET attempts = attempts + 1 WHERE id = ? AND status = 'pending' AND attempts = ?",
        [SqlValue::Text(id), SqlValue::Int(attempts)]);
    let Ok(1) = claimed else { return "pending"; };
    let mut o: Map<Str, Json> = Map::new();
    o.insert("text", Json::Str(text));
    let sent = slack.send_all([HttpRequest { method: "POST", path: "/hook", headers: ["content-type: application/json"],
        body: Json::Obj(o).to_json().to_bytes(), timeout_ms: 2000 }]);
    let ok = match sent[0] {
        Ok(r) => r.status >= 200 && r.status < 300,
        Err(_) => false,
    };
    if !ok {
        if attempts + 1 >= MAX_ATTEMPTS {
            let _given_up = db.exec("UPDATE events SET status = 'failed' WHERE id = ? AND status = 'pending'", [SqlValue::Text(id)]);
            return "failed";
        }
        return "pending";
    }
    let marked = db.exec("UPDATE events SET status = 'sent' WHERE id = ?", [SqlValue::Text(id)]);
    if marked.is_err() { return "pending"; }
    "notified"
}

// Retry the oldest pending events but `skip` (the one this request just stored, already tried).
// A database error means nothing to retry yet.
fn retry_pending(db: Db, slack: Http, log: Log, skip: Str) {
    let found = db.query("SELECT id, kind, text, attempts FROM events WHERE status = 'pending' AND attempts < ? AND id != ? ORDER BY rowid LIMIT ?",
        [SqlValue::Int(MAX_ATTEMPTS), SqlValue::Text(skip), SqlValue::Int(RETRIES_PER_REQUEST)]);
    let rows = match found { Ok(r) => r, Err(_) => return };
    for row in rows {
        let id = text_of(row[0]);
        let outcome = deliver(db, slack, id, text_of(row[2]), int_of(row[3]));
        if outcome == "notified" {
            let _written = log.write(id + " " + text_of(row[1]) + " retried");
        } else if outcome == "failed" {
            let _written = log.write(id + " " + text_of(row[1]) + " failed");
        }
    }
}

fn text_of(v: SqlValue) -> Str {
    match v { SqlValue::Text(s) => s, _ => "" }
}

fn int_of(v: SqlValue) -> Int {
    match v { SqlValue::Int(n) => n, _ => 0 }
}

// The event's id and type, and for the types that notify the chat, the message to send.
fn parse_event(j: Json) -> Result<Ev, Str> {
    let id = match api::str_field(j, "id") { Some(s) => s, None => return Err("missing string field \"id\"") };
    let kind = match api::str_field(j, "type") { Some(s) => s, None => return Err("missing string field \"type\"") };
    let text = message(kind, j)?;
    Ok(Ev { id: id, kind: kind, text: text })
}

// "" for a type that sends no message.
fn message(kind: Str, j: Json) -> Result<Str, Str> {
    let verb = match kind {
        "payment_intent.succeeded" => "Payment succeeded: ",
        "charge.refunded" => "Refund: ",
        _ => return Ok(""),
    };
    let o = match j.get("data").and_then(|d| d.get("object")) {
        Some(o) => o,
        None => return Err("missing object \"data.object\""),
    };
    let cents = match api::int_field(o, "amount") {
        Some(c) => c,
        None => return Err("missing integer field \"amount\" in data.object"),
    };
    if cents < 0 { return Err("amount must not be negative"); }
    let currency = match api::str_field(o, "currency") {
        Some(c) => c.to_uppercase(),
        None => return Err("missing string field \"currency\" in data.object"),
    };
    let customer = match api::str_field(o, "customer") {
        Some(c) => c,
        None => return Err("missing string field \"customer\" in data.object"),
    };
    let sep = if kind == "charge.refunded" { " to " } else { " from " };
    Ok(verb + dollars(cents) + " " + currency + sep + customer)
}

// 1234 as "$12.34".
fn dollars(cents: Int) -> Str {
    let c = cents % 100;
    "$" + (cents / 100).to_str() + "." + (if c < 10 { "0" } else { "" }) + c.to_str()
}

// Create the table if needed and add the event: Ok(true) when it is new, Ok(false) for a replay.
fn store(db: Db, ev: Ev, now_ms: Int) -> Result<Bool, Str> {
    let made = db.exec("CREATE TABLE IF NOT EXISTS events (id TEXT PRIMARY KEY, kind TEXT NOT NULL, text TEXT NOT NULL, status TEXT NOT NULL, attempts INTEGER NOT NULL, created_ms INTEGER NOT NULL)", []);
    if made.is_err() { return Err("database error"); }
    let status = if ev.text == "" { "stored" } else { "pending" };
    let added = db.exec("INSERT INTO events (id, kind, text, status, attempts, created_ms) VALUES (?, ?, ?, ?, 0, ?)",
        [SqlValue::Text(ev.id), SqlValue::Text(ev.kind), SqlValue::Text(ev.text), SqlValue::Text(status), SqlValue::Int(now_ms)]);
    match added {
        Ok(_) => Ok(true),
        Err(DbErr::Constraint(_)) => Ok(false),
        Err(_) => Err("database error"),
    }
}

// `Stripe-Signature: t=<unix s>,v1=<hex>[,v1=<hex>..]`: some v1 must be the HMAC of "<t>.<body>",
// and t within 300 s of `now_s`. The signature is checked first, so a stale but forged header and a
// fresh forged one answer alike.
fn check_signature(stripe: Hmac, header: Str, body: Bytes, now_s: Int) -> Result<(), Str> {
    let mut t = "";
    let mut macs: List<Str> = [];
    for part in header.split(",") {
        let p = part.trim();
        if let Some(v) = p.strip_prefix("t=") { t = v; }
        if let Some(v) = p.strip_prefix("v1=") { macs.push(v); }
    }
    let ts = match t.parse_int() {
        Some(n) => n,
        None => return Err("Stripe-Signature has no timestamp t="),
    };
    let mut msg = (t + ".").to_bytes();
    msg.extend(body);
    let mut ok = false;
    for m in macs {
        if stripe.verify(msg, unhex(m)) { ok = true; }
    }
    if !ok { return Err("bad signature"); }
    let skew = now_s - ts;
    if skew > 300 || skew < 0 - 300 { return Err("timestamp outside the 300 s tolerance"); }
    Ok(())
}

// The bytes of hex text; empty for odd length or a non-hex character (which verify rejects).
fn unhex(s: Str) -> Bytes {
    let b = s.to_bytes();
    let mut out = "".to_bytes();
    if b.len() % 2 != 0 { return out; }
    let mut i = 0;
    while i < b.len() {
        let hi = match nibble(b[i]) { Some(v) => v, None => return "".to_bytes() };
        let lo = match nibble(b[i + 1]) { Some(v) => v, None => return "".to_bytes() };
        out.push(hi * 16 + lo);
        i += 2;
    }
    out
}

fn nibble(c: Int) -> Option<Int> {
    if c >= 48 && c <= 57 { return Some(c - 48); }
    if c >= 97 && c <= 102 { return Some(c - 87); }
    if c >= 65 && c <= 70 { return Some(c - 55); }
    None
}
