// A notes JSON API over a granted Dir: one file `<id>.json` per note.
// `kio run app.kio --dir notes=./data --listen 127.0.0.1:8080`
mod web;
mod json;
mod api;

fn main(req: Incoming, res: Outgoing, notes: Dir) -> Result<(), WebErr> {
    let r = web::request(req);
    web::send(res, handle(r, notes))
}

fn handle(r: web::Request, notes: Dir) -> web::Response {
    if let Some(_) = web::route(r, "POST", "/notes") { return create(r, notes); }
    if let Some(_) = web::route(r, "GET", "/notes") { return list(notes); }
    if let Some(p) = web::route(r, "GET", "/notes/:id") { return show(notes, p.get(":id").unwrap_or("")); }
    if let Some(p) = web::route(r, "PUT", "/notes/:id") { return replace(r, notes, p.get(":id").unwrap_or("")); }
    if let Some(p) = web::route(r, "DELETE", "/notes/:id") { return delete(notes, p.get(":id").unwrap_or("")); }
    web::not_found()
}

fn file(id: Int) -> Str { id.to_str() + ".json" }

fn note(id: Int, title: Str, body: Str) -> json::Json {
    let mut o: Map<Str, json::Json> = Map::new();
    o.insert("id", json::Json::Num(id));
    o.insert("title", json::Json::Str(title));
    o.insert("body", json::Json::Str(body));
    json::Json::Obj(o)
}

fn io_error() -> web::Response { api::error(500, "storage error") }

// The id a file name stands for: "7.json" is 7; anything else is None.
fn id_of(name: Str) -> Option<Int> {
    name.strip_suffix(".json")?.parse_int()
}

// Every note id, from one directory listing.
fn ids(notes: Dir) -> Result<List<Int>, IoErr> {
    let mut out: List<Int> = [];
    for name in notes.list("")? {
        if let Some(id) = id_of(name) { out.push(id); }
    }
    out.sort();
    Ok(out)
}

// One more than the largest id, or 1 when there are no notes.
fn next_id(notes: Dir) -> Result<Int, IoErr> {
    let mut top = 0;
    for id in ids(notes)? {
        if id > top { top = id; }
    }
    Ok(top + 1)
}

fn parse_id(id: Str) -> Result<Int, web::Response> {
    match id.parse_int() {
        Some(n) => Ok(n),
        None => Err(api::error(400, "note id must be an integer")),
    }
}

// POST /notes: validate the body, then create the file under the next id.
fn create(r: web::Request, notes: Dir) -> web::Response {
    let f = match api::str_fields(r, ["title", "body"]) {
        Ok(f) => f,
        Err(e) => return e,
    };
    store(notes, f[0], f[1])
}

// `create` refuses to overwrite, so when a racing POST took the id (Exists), pick again.
fn store(notes: Dir, title: Str, body: Str) -> web::Response {
    for _try in 0..1000 {
        let id = match next_id(notes) {
            Ok(id) => id,
            Err(_) => return io_error(),
        };
        let doc = json::encode(note(id, title, body)).to_bytes();
        match notes.create(file(id), doc) {
            Ok(_) => return api::json(201, note(id, title, body)),
            Err(IoErr::Exists) => {}
            Err(_) => return io_error(),
        }
    }
    api::error(503, "too many concurrent writers")
}

fn load(notes: Dir, id: Int) -> Option<json::Json> {
    match notes.read(file(id)) {
        Ok(b) => match json::parse(b.to_str()) {
            Ok(j) => Some(j),
            Err(_) => None,
        },
        Err(_) => None,
    }
}

fn show(notes: Dir, id: Str) -> web::Response {
    let n = match parse_id(id) {
        Ok(n) => n,
        Err(e) => return e,
    };
    match load(notes, n) {
        Some(j) => api::json(200, j),
        None => api::error(404, "no note " + id),
    }
}

// GET /notes: every note, in id order.
fn list(notes: Dir) -> web::Response {
    let mut all: List<json::Json> = [];
    let found = match ids(notes) {
        Ok(v) => v,
        Err(_) => return io_error(),
    };
    for id in found {
        if let Some(j) = load(notes, id) { all.push(j); }
    }
    api::json(200, json::Json::Arr(all))
}

// PUT /notes/:id: replace an existing note.
fn replace(r: web::Request, notes: Dir, id: Str) -> web::Response {
    let n = match parse_id(id) {
        Ok(n) => n,
        Err(e) => return e,
    };
    match notes.exists(file(n)) {
        Ok(true) => {}
        Ok(false) => return api::error(404, "no note " + id),
        Err(_) => return io_error(),
    }
    let f = match api::str_fields(r, ["title", "body"]) {
        Ok(f) => f,
        Err(e) => return e,
    };
    match notes.write(file(n), json::encode(note(n, f[0], f[1])).to_bytes()) {
        Ok(_) => api::json(200, note(n, f[0], f[1])),
        Err(_) => io_error(),
    }
}

// DELETE /notes/:id
fn delete(notes: Dir, id: Str) -> web::Response {
    let n = match parse_id(id) {
        Ok(n) => n,
        Err(e) => return e,
    };
    match notes.remove(file(n)) {
        Ok(_) => web::respond(204, "text/plain", "".to_bytes()),
        Err(IoErr::NotFound) => api::error(404, "no note " + id),
        Err(_) => io_error(),
    }
}
