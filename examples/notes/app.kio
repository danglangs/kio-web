// A notes JSON API over a granted Dir: one file `<id>.json` per note.
// `kio run app.kio --dir notes=./data --listen 127.0.0.1:8080`
// `Dir` cannot list, overwrite or delete, so ids are found by probing `read` for 1, 2, 3.. until
// NotFound; `create` refuses to overwrite, so two racing POSTs cannot take the same id.
mod web;
mod json;

fn main(req: Incoming, res: Outgoing, notes: Dir) -> Result<(), WebErr> {
    let r = web::request(req);
    web::send(res, handle(r, notes))
}

fn handle(r: web::Request, notes: Dir) -> web::Response {
    match web::route(r, "POST", "/notes") {
        Some(_) => { return create(r, notes); }
        None => {}
    }
    match web::route(r, "GET", "/notes") {
        Some(_) => { return list(notes); }
        None => {}
    }
    match web::route(r, "GET", "/notes/:id") {
        Some(p) => { return show(notes, p.get(":id").unwrap_or("")); }
        None => {}
    }
    match web::route(r, "PUT", "/notes/:id") {
        Some(_) => { return unsupported("update", "overwrite"); }
        None => {}
    }
    match web::route(r, "DELETE", "/notes/:id") {
        Some(_) => { return unsupported("delete", "delete"); }
        None => {}
    }
    web::not_found()
}

fn unsupported(what: Str, method: Str) -> web::Response {
    error(501, "cannot " + what + " a note: Dir has no `" + method + "` method")
}

fn error(status: Int, msg: Str) -> web::Response {
    let mut o: Map<Str, json::Json> = Map::new();
    o.insert("error", json::Json::Str(msg));
    web::json(status, json::encode(json::Json::Obj(o)))
}

fn file(id: Int) -> Str { id.to_str() + ".json" }

fn str_field(j: json::Json, key: Str) -> Option<Str> {
    json::as_str(json::get(j, key)?)
}

// POST /notes: validate the body, then store it under the next free id.
fn create(r: web::Request, notes: Dir) -> web::Response {
    let j = match json::parse(r.body.to_str()) {
        Ok(j) => j,
        Err(e) => { return error(400, e); }
    };
    let title = match str_field(j, "title") {
        Some(s) => s,
        None => { return error(400, "missing string field \"title\""); }
    };
    let body = match str_field(j, "body") {
        Some(s) => s,
        None => { return error(400, "missing string field \"body\""); }
    };
    store(notes, title, body)
}

// Probe for a free id and create it; if another request took it first, probe on.
fn store(notes: Dir, title: Str, body: Str) -> web::Response {
    let mut id = next_id(notes, 1);
    while id < 100000 {
        let doc = json::encode(note(id, title, body)).to_bytes();
        match notes.create(file(id), doc) {
            Ok(_) => { return web::json(201, json::encode(note(id, title, body))); }
            Err(_) => { id = next_id(notes, id + 1); }
        }
    }
    error(507, "too many notes")
}

// The first id >= `from` with no file.
fn next_id(notes: Dir, from: Int) -> Int {
    let mut id = from;
    while exists(notes, id) { id += 1; }
    id
}

fn exists(notes: Dir, id: Int) -> Bool {
    match notes.read(file(id)) {
        Ok(_) => true,
        Err(_) => false,
    }
}

fn note(id: Int, title: Str, body: Str) -> json::Json {
    let mut o: Map<Str, json::Json> = Map::new();
    o.insert("id", json::Json::Num(id));
    o.insert("title", json::Json::Str(title));
    o.insert("body", json::Json::Str(body));
    json::Json::Obj(o)
}

fn load(notes: Dir, id: Int) -> Option<json::Json> {
    match notes.read(file(id)) {
        Ok(b) => match json::parse(b.to_str()) {
            Ok(j) => Some(j),
            Err(_) => None,
        },
        Err(_) => None,
    }
}

fn show(notes: Dir, id: Str) -> web::Response {
    let n = match id.parse_int() {
        Some(n) => n,
        None => { return error(400, "note id must be an integer"); }
    };
    match load(notes, n) {
        Some(j) => web::json(200, json::encode(j)),
        None => error(404, "no note " + id),
    }
}

// GET /notes: every note, by probing ids until the first gap.
fn list(notes: Dir) -> web::Response {
    let mut all: List<json::Json> = [];
    let mut id = 1;
    while true {
        match load(notes, id) {
            Some(j) => { all.push(j); id += 1; }
            None => { break; }
        }
    }
    web::json(200, json::encode(json::Json::Arr(all)))
}
