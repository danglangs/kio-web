// A notes JSON API over a granted Kv: notes under `note/<id>`, ids from a counter under `next`.
// `kio run app.kio --kv notes=:memory: --listen 127.0.0.1:8080`
mod web;
mod api;

fn main(req: Incoming, res: Outgoing, notes: Kv) -> Result<(), WebErr> {
    let r = web::request(req);
    web::send(res, handle(r, notes))
}

// What a request asks for. Handlers use the app's capability, so they cannot be function values
// in a route table (rule 1); the table holds these ids and `handle` calls the named function.
enum Act { Create, List, Show, Replace, Delete }

fn routes() -> List<web::Route<Act>> {
    [web::post("/notes", Act::Create), web::get("/notes", Act::List), web::get("/notes/:id", Act::Show),
     web::put("/notes/:id", Act::Replace), web::delete("/notes/:id", Act::Delete)]
}

fn handle(r: web::Request, notes: Kv) -> web::Response {
    let m = match web::dispatch(routes(), r) {
        Some(m) => m,
        None => return web::not_found(),
    };
    let id = web::param(m, "id");
    match m.action {
        Act::Create => create(r, notes),
        Act::List => list(r, notes),
        Act::Show => show(notes, id),
        Act::Replace => replace(r, notes, id),
        Act::Delete => delete(notes, id),
    }
}

fn note(id: Int, title: Str, body: Str) -> Json {
    let mut o: Map<Str, Json> = Map::new();
    o.insert("id", Json::Num(id));
    o.insert("title", Json::Str(title));
    o.insert("body", Json::Str(body));
    Json::Obj(o)
}

fn io_error() -> web::Response { api::error(500, "storage error") }

fn key(id: Int) -> Str { "note/" + id.to_str() }

// The id a key stands for: "note/7" is 7.
fn id_of(k: Str) -> Option<Int> { k.strip_prefix("note/")?.parse_int() }

// POST /notes: validate the body, then store it under the next id.
fn create(r: web::Request, notes: Kv) -> web::Response {
    let f = match api::str_fields(r, ["title", "body"]) {
        Ok(f) => f,
        Err(e) => return e,
    };
    let id = match take_id(notes) {
        Ok(id) => id,
        Err(_) => return io_error(),
    };
    match notes.set(key(id), note(id, f[0], f[1]).to_json().to_bytes()) {
        Ok(_) => api::json(201, note(id, f[0], f[1])),
        Err(_) => io_error(),
    }
}

// Claim the next id: read the counter, swap it to +1, and read again if another request got there.
fn take_id(notes: Kv) -> Result<Int, KvErr> {
    for _try in 0..1000 {
        let old = notes.get("next")?;
        let id = match old {
            Some(b) => b.to_str().parse_int().unwrap_or(1),
            None => 1,
        };
        if notes.swap("next", old, Some((id + 1).to_str().to_bytes()))? { return Ok(id); }
    }
    Err(KvErr::Full)
}

fn load(notes: Kv, id: Int) -> Option<Json> {
    match notes.get(key(id)) {
        Ok(Some(b)) => match b.to_str().parse_json() {
            Ok(j) => Some(j),
            Err(_) => None,
        },
        Ok(None) => None,
        Err(_) => None,
    }
}

fn show(notes: Kv, id: Str) -> web::Response {
    let n = match api::int_param(id, "note id") {
        Ok(n) => n,
        Err(e) => return e,
    };
    match load(notes, n) {
        Some(j) => api::json(200, j),
        None => api::error(404, "no note " + id),
    }
}

// GET /notes: notes in id order; ?offset= and ?limit= (default 50, at most 500) pick a page.
fn list(r: web::Request, notes: Kv) -> web::Response {
    let keys = match notes.keys("note/") {
        Ok(v) => v,
        Err(_) => return io_error(),
    };
    let mut found = api::flatten(keys.map(id_of));
    found.sort();
    let mut all: List<Json> = [];
    let p = match api::page(found, r) {
        Ok(p) => p,
        Err(e) => return e,
    };
    for id in p.items {
        if let Some(j) = load(notes, id) { all.push(j); }
    }
    api::json(200, Json::Arr(all))
}

// PUT /notes/:id: replace an existing note. Swapping against the value just read means a note
// deleted in between stays deleted.
fn replace(r: web::Request, notes: Kv, id: Str) -> web::Response {
    let n = match api::int_param(id, "note id") {
        Ok(n) => n,
        Err(e) => return e,
    };
    let old = match notes.get(key(n)) {
        Ok(v) => v,
        Err(_) => return io_error(),
    };
    if old.is_none() { return api::error(404, "no note " + id); }
    let f = match api::str_fields(r, ["title", "body"]) {
        Ok(f) => f,
        Err(e) => return e,
    };
    let new = Some(note(n, f[0], f[1]).to_json().to_bytes());
    match notes.swap(key(n), old, new) {
        Ok(done) => {
            if done { return api::json(200, note(n, f[0], f[1])); }
            replace(r, notes, id)
        }
        Err(_) => io_error(),
    }
}

// DELETE /notes/:id
fn delete(notes: Kv, id: Str) -> web::Response {
    let n = match api::int_param(id, "note id") {
        Ok(n) => n,
        Err(e) => return e,
    };
    let old = match notes.get(key(n)) {
        Ok(v) => v,
        Err(_) => return io_error(),
    };
    if old.is_none() { return api::error(404, "no note " + id); }
    match notes.swap(key(n), old, None) {
        Ok(done) => {
            if done { return web::respond(204, "text/plain", "".to_bytes()); }
            delete(notes, id)
        }
        Err(_) => io_error(),
    }
}
